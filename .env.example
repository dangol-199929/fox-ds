# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real tokens or secrets.
# In Vercel, set the same names under Project → Settings → Environment Variables.

# --- Shopify Storefront API (required) --------------------------------------

# Your store's permanent *.myshopify.com domain, without https://
# Not sensitive.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API version, YYYY-MM. 2026-10 is the latest stable release.
# Not sensitive.
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Public Storefront API access token from the Headless sales channel.
# Shopify designs this token to be safe in a browser, but this app only uses it
# on the server, so it deliberately has no NEXT_PUBLIC_ prefix and is never
# bundled into client JavaScript.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# --- Webhooks (needed from the webhook phase) -------------------------------

# SECRET. Signing secret used to verify Shopify webhook HMAC signatures.
# Server only. Never expose to the browser or commit it.
SHOPIFY_WEBHOOK_SECRET=

# --- Site --------------------------------------------------------------------

# Public base URL, used for canonical URLs, sitemap and sign-in redirects.
# Public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
